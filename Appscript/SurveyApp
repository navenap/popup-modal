function doGet(e) {

  const deviceSerial = e.parameter.device_serial;

  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const userSheet = ss.getSheetByName("users");
  const qSheet = ss.getSheetByName("questions");
  const rSheet = ss.getSheetByName("responses");

  const userData = userSheet.getDataRange().getValues();
  const qData = qSheet.getDataRange().getValues();
  const rData = rSheet.getDataRange().getValues();

  const userHeaders = userData[0];
  const qHeaders = qData[0];

  const users = userData.slice(1);
  const questions = qData.slice(1);
  const responses = rData.slice(1);

  // FIND USER
  let user = null;

  for (let row of users) {

    const serial = row[2];

    if (String(serial).trim() === String(deviceSerial).trim()) {

      user = {
        email: row[0],
        manufacturer: row[1],
        serial: row[2],
        group: row[3]
      };

      break;
    }
  }

  if (!user) {

    return ContentService
      .createTextOutput(JSON.stringify({
        status: "error",
        message: "User not found"
      }))
      .setMimeType(ContentService.MimeType.JSON);
  }

  // ANSWERED QUESTIONS
  const answeredIds = new Set();

  responses.forEach(row => {

    const serial = row[1];
    const qid = row[3];

    if (String(serial) === String(deviceSerial)) {

      answeredIds.add(String(qid));
    }
  });

  // FILTER QUESTIONS BY GROUP
  const result = questions
    .map(row => {

      let obj = {};

      qHeaders.forEach((h, i) => {
        obj[h] = row[i];
      });

      return obj;
    })
    .filter(q =>
      q.group === user.group &&
      !answeredIds.has(String(q.id))
    )
    .map(q => ({
      id: q.id,
      question: q.question,
      type: q.type,
      options: String(q.options).split(",")
    }));

  return ContentService
    .createTextOutput(JSON.stringify(result))
    .setMimeType(ContentService.MimeType.JSON);
}

function doPost(e) {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("responses");
  const data = JSON.parse(e.postData.contents);

  if (!data.answers || data.answers.length === 0) {
    return ContentService
      .createTextOutput(JSON.stringify({ status: "error", message: "No answers provided" }))
      .setMimeType(ContentService.MimeType.JSON);
  }

  const existing = sheet.getDataRange().getValues();

  const rowsToInsert = [];
  const timestamp = new Date();

  data.answers.forEach(ans => {
    const alreadyAnswered = existing.some(row =>
      row[1] === data.device_serial && row[3] == ans.question_id
    );

    if (!alreadyAnswered) {
      rowsToInsert.push([
        timestamp,
        data.device_serial,
        data.username,
        ans.question_id,
        ans.answer
      ]);
    }
  });

  if (rowsToInsert.length > 0) {
    sheet.getRange(sheet.getLastRow() + 1, 1, rowsToInsert.length, rowsToInsert[0].length)
         .setValues(rowsToInsert);
  }

  return ContentService
    .createTextOutput(JSON.stringify({ status: "success" }))
    .setMimeType(ContentService.MimeType.JSON);
}
