<Window x:Class="SurveyApp.AdminPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SurveyApp"
        mc:Ignorable="d"
        Title="Admin Access" Height="250" Width="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="20">
        <StackPanel>

            <TextBlock Text="Enter Admin Password"
                       FontSize="16"
                       Margin="0,0,0,10"/>

            <Grid>
                <PasswordBox x:Name="PasswordBox"
                             Height="30"
                             Padding="5"/>

                <TextBox x:Name="VisibleText"
                         Height="30"
                         Padding="5"
                         Visibility="Collapsed"/>
            </Grid>

            <CheckBox Content="Show Password"
                      Margin="0,5,0,10"
                      Checked="ShowPassword_Checked"
                      Unchecked="ShowPassword_Unchecked"/>

            <Button Content="Submit"
                    Height="30"
                    Click="Submit_Click"/>
        </StackPanel>
        
    </Grid>
</Window>
